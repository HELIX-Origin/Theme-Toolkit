# Normalize line endings across platforms so agents on Windows, Linux, and
# macOS see byte-identical files and the working tree never churns.
* text=auto eol=lf

# Explicit text types
*.md        text eol=lf
*.jsonc     text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sh        text eol=lf
*.ps1       text eol=lf
*.svg       text eol=lf
*.rs        text eol=lf
*.toml      text eol=lf
*.ts        text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.svelte    text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.ddf       text eol=lf
*.theme     text eol=lf

# Windows batch scripts must keep CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binary types
*.png       binary
*.jpg       binary
*.jpeg      binary
*.ico       binary
*.cur       binary
*.ani       binary
*.wav       binary
*.oga       binary
*.ogg       binary
*.heic      binary
*.deskthemepack binary
*.cab       binary
